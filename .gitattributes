# Normalise line endings
* text=auto

# Unity serialises scenes, prefabs and assets as YAML text
*.unity       text eol=lf linguist-generated
*.prefab      text eol=lf linguist-generated
*.asset       text eol=lf linguist-generated
*.mat         text eol=lf linguist-generated
*.meta        text eol=lf linguist-generated
*.controller  text eol=lf linguist-generated

# Binary files
*.png  binary
*.jpg  binary
*.gif  binary
*.mp4  binary
*.pdf  binary
*.glb  binary
*.mind binary
*.dat  binary

# Language stats: count my own code, not bundled third-party packages
"Assets/TextMesh Pro/**" linguist-vendored
docs/libs/** linguist-vendored
